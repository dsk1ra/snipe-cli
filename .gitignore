batch/jds/
batch/scores/
batch/evals/
batch/errors/
coverage/
.nyc_output/
batch/cv-index.json
batch/jd-index.json
batch/cv-spike.json

# Interview prep (accumulated STAR+R stories — user data)
interview-prep/*
!interview-prep/.gitkeep

# User config and customization (never auto-updated; *.template.md / *.example.yml stay tracked)
config/profile.yml
config/profile.md
portals.yml

# Personal model-prompt overrides (real metrics; shipped *.md is the generic placeholder)
batch/*.local.md

# Benchmark runs + labels (personal CV/JD evaluation data — the harness ships, the runs don't)
# Bench scratch is ignored, with one exception: example_copy_pct (tailor-harness.mjs)
# and test/units.test.mjs both read example-bullets.json, and the metric reads 0 by
# construction without it — the worked example it snapshots is gone from the prompt.
# A directory exclusion cannot be negated per-file, hence the glob.
batch/bench/*
!batch/bench/example-bullets.json
batch/labels.tsv
batch/labels/
batch/labels.xlsx

# Secrets (never commit — use .env.example as template)
.env

# Generated
node_modules/
# Report-number reservation sentinels (ephemeral, created by reserve-report-num.mjs)
reports/*-RESERVED.md

# Backup files (normalize-statuses.mjs, dedup-tracker.mjs, manual *.bak snapshots)
*.bak

# OS
.DS_Store
*.mov
*.mp4

# CLI-specific local config
.claude/settings.local.json
.claude/memory/

# Playwright MCP server run artifacts (ephemeral, machine-local — never commit)
.playwright-mcp/

# Planning (local scratchpad)
plan/

# Generated CV artefacts and the PII-bearing gold-set fixtures — local only.
# Regenerate: goldset.mjs sheet / export-shots (see batch/bench/README.md)
cv.pdf
batch/judge-shots.json
batch/timings.tsv
# Every cv.md bullet's source text, employers and dates — cv.md by another name.
# Regenerate: node batch/bench-tools/gen-cv-bank.mjs
batch/cv-bank.json
